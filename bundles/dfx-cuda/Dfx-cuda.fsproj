<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>dfx-cuda</PackageId>
    <Description>dfx, a tensor library for F# with support for differentiable programming, with the LibTorch CUDA 12.8 binaries for both Windows (x64) and Linux (x64). Large download.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Empty.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dfx-cuda-windows\Dfx-cuda-windows.fsproj" />
    <ProjectReference Include="..\dfx-cuda-linux\Dfx-cuda-linux.fsproj" />
    <PackageReference Update="FSharp.Core" Version="$(FSharpCoreVersion)" />
  </ItemGroup>

</Project>
