<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>dfx-lite</PackageId>
    <Description>dfx, a tensor library for F# with support for differentiable programming, without LibTorch binaries, for use with a LibTorch installed by other means, for example with PyTorch.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Empty.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dfx.Core\Dfx.Core.fsproj" />
    <ProjectReference Include="..\..\src\Dfx.Data\Dfx.Data.fsproj" />
    <ProjectReference Include="..\..\src\Dfx.Backends.Reference\Dfx.Backends.Reference.fsproj" />
    <ProjectReference Include="..\..\src\Dfx.Backends.Torch\Dfx.Backends.Torch.fsproj" />
	<PackageReference Update="FSharp.Core" Version="$(FSharpCoreVersion)" />
  </ItemGroup>

</Project>