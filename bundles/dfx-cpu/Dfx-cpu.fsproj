<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>dfx-cpu</PackageId>
    <Description>dfx, a tensor library for F# with support for differentiable programming, with the LibTorch CPU binaries for Windows (x64), Linux (x64) and macOS (Apple Silicon).</Description>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Include="Empty.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dfx.Core\Dfx.Core.fsproj" />
    <ProjectReference Include="..\..\src\Dfx.Data\Dfx.Data.fsproj" />
    <ProjectReference Include="..\..\src\Dfx.Backends.Reference\Dfx.Backends.Reference.fsproj" />
    <ProjectReference Include="..\..\src\Dfx.Backends.Torch\Dfx.Backends.Torch.fsproj" />
    <!-- reference a TorchSharp bundle with libtorch runtime redist -->
    <PackageReference Include="TorchSharp-cpu" Version="$(TorchSharpVersion)" />
	  <PackageReference Update="FSharp.Core" Version="$(FSharpCoreVersion)" />
  </ItemGroup>

</Project>