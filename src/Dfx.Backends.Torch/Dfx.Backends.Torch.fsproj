<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>dfx-Dfx.Backends.Torch</PackageId>
    <Description>The Torch backend for dfx, using LibTorch through TorchSharp. It does not include the LibTorch binaries. Most applications should reference a package that includes the LibTorch binaries, such as dfx-cpu, instead.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Torch.RawTensor.fs" />
    <Compile Include="Dfx.Torch.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dfx.Core\Dfx.Core.fsproj" />
    <PackageReference Include="TorchSharp" Version="$(TorchSharpVersion)" />
	  <PackageReference Update="FSharp.Core" Version="$(FSharpCoreVersion)" />
  </ItemGroup>

</Project>
