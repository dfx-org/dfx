<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>dfx-Dfx.Data</PackageId>
    <Description>Datasets, data loaders, image and plotting utilities for dfx. Most applications should reference a package that includes the LibTorch binaries, such as dfx-cpu, instead.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Image.fs" />
    <Compile Include="Data.fs" />
    <Compile Include="Plot.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dfx.Core\Dfx.Core.fsproj" />
  	<PackageReference Update="FSharp.Core" Version="$(FSharpCoreVersion)" />
    <!-- SkiaSharp is kept on the 2.x line referenced by TorchSharp. The SkiaSharp package includes the Windows and macOS native libraries; -->
    <!-- the Linux ones are a separate package, which is built without a dependency on fontconfig. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
  </ItemGroup>

</Project>
