<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>dfx-Dfx.Data</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Image.fs" />
    <Compile Include="Data.fs" />
    <Compile Include="Plot.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dfx.Core\Dfx.Core.fsproj" />
  	<PackageReference Update="FSharp.Core" Version="$(FSharpCoreVersion)" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>

</Project>
